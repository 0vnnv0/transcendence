// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

model TestUser {
  id          Int      @id
  login       String   @unique

  intraEmail  String?

  firstName   String?
  lastName    String?

  avatarUrl   String?
  intraUrl    String?
  
  campusId    Int?
  campusName  String?

  coalitionName String?
  coalitionSlug String?

  currentRank	Int?
  newCore		Boolean?

  completedProjects Json?
  activeProjects    Json?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model LoggedUser {
	id				Int			@id @default(autoincrement())
	email			String		@unique
	password		String?
	createdAt		DateTime	@default(now())
}

model User { 
	id				Int			@id 	//check
	createdAt		DateTime	@default(now()) 				//check
	intraEmail		String		@unique							//check
	intraName		String		@unique							//check, aber heisst login
	campusID		Int										//check			
	campusName		String										//check
	currentRank		Int
	paceDeadline	DateTime
	blackholeDate	DateTime?

	coalitionName 	String?										//check
	coalitionSlug 	String?										//check

	bio				String?
	avatarUrl		String?
	customAvatar	String?
	quests			UserQuests?
	projects		UserProjects[]
	availability	Availability?

	chats			Chat[]		@relation("UserToChat")
	sentMessages	ChatMessage[]
	isOnline		Boolean		@default(false)
	newCore			Boolean?

	sentFriendships     Friendship[] @relation("SentFriendships")
  	receivedFriendships Friendship[] @relation("ReceivedFriendships")
} 

model UserQuests {
	id				Int			@id @default(autoincrement()) 
	user			User		@relation(fields: [userId], references: [id])
	userId			Int			@unique
	rank1			Boolean		@default(false)
	rank2			Boolean		@default(false)
	rank3			Boolean		@default(false)
	rank4			Boolean		@default(false)
	rank5			Boolean		@default(false)
	rank6			Boolean		@default(false)
}

model Project {
  id              Int      @id @default(autoincrement())

  name            String
  slug            String   @unique

  projectRank     Int

  teamSizeMin     Int
  teamSizeMax     Int

  estimatedHours  Int?
  xpPoints        Int?

  description     String?

  keywords    String[]
  skills      String[]

  oldCore         Boolean  @default(false)
  newCore         Boolean  @default(false)

  users           UserProjects[]
}

model UserProjects {
  id         Int      @id @default(autoincrement())

  userId     Int
  projectId  Int

  user       User     @relation(fields: [userId], references: [id])
  project    Project  @relation(fields: [projectId], references: [id])

  createdAt  DateTime @default(now())
}

model Availability {
	id				Int			@id @default(autoincrement()) 
	user			User		@relation(fields: [userId], references: [id])
	userId			Int			@unique
	workDaysPerWeek	Int
	startDate		DateTime
	endDate			DateTime
	preferredDays	String[]
	isRemote		Boolean  	@default(false)
}

model Chat {
	id				Int			@id @default(autoincrement()) 
	createdAt		DateTime	@default(now())
	updatedAt		DateTime	@updatedAt
	users			User[]		@relation("UserToChat")
	messages		ChatMessage[]
}

model ChatMessage {
	id				Int			@id @default(autoincrement())
	chat			Chat		@relation(fields: [chatId], references: [id])
	chatId			Int
	sender			User		@relation(fields: [senderId], references: [id])
	senderId		Int
	createdAt		DateTime	@default(now())
	content			String
}

model Friendship {
  id          Int              @id @default(autoincrement())
  
  senderId    Int
  sender      User             @relation("SentFriendships", fields: [senderId], references: [id], onDelete: Cascade)

  receiverId  Int
  receiver    User             @relation("ReceivedFriendships", fields: [receiverId], references: [id], onDelete: Cascade)

  status      FriendshipStatus @default(PENDING)

  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  // Stellt sicher, dass A an B nur EINE Anfrage gleichzeitig schicken kann
  @@unique([senderId, receiverId])
}

model BlacklistedTokens {
	id				Int			@id @default(autoincrement())
	token			String		@unique
	expiresAt		DateTime
	createdAt		DateTime	@default(now())
}

enum Status {
	NOT_STARTED
	IN_PROGRESS
	FINISHED
}

enum FriendshipStatus {
  PENDING
  ACCEPTED
  BLOCKED
}
