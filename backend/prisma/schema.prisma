model Project {
  id              Int      @id @default(autoincrement())

  name            String
  slug            String   @unique

  projectRank     Int

  teamSizeMin     Int
  teamSizeMax     Int

  estimatedHours  Int?
  xpPoints        Int?

  description     String?

  keywords    String[]
  skills      String[]

  oldCore         Boolean  @default(false)
  newCore         Boolean  @default(false)

//   users           UserProjects[]
}

