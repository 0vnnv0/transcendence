{
  "compilerOptions": {
    "target": "ES2020",
    "module": "node16",
    "rootDir": "./src",
    "outDir": "./dist",
	"types": ["node"],

    "strict": true,
    "esModuleInterop": true,

    "skipLibCheck": true,
	"resolveJsonModule": true,
  },
  "include": [
    "src/**/*",
    "src/types/**/*.d.ts"
  ],
  "exclude": [
    "node_modules",
    "prisma.config.ts" 
  ]
}